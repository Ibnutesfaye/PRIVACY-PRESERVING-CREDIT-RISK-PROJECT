# Copy to .env only for local development. Never commit a real .env file.
APPLICATION_ENVIRONMENT=development
APPLICATION_SERVICE_NAME=cipherscore-api
APPLICATION_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SECURITY_MAX_REQUEST_BYTES=50000000
SECURITY_TRUST_PROXY_HEADERS=false
# Compatibility-only trusted-gateway plaintext endpoint. This must be false in production.
MODEL_PLAINTEXT_PREDICTION_ENABLED=true
OPENFHE_WORKER_TIMEOUT_SECONDS=120
OPENFHE_ENCRYPTED_API_ENABLED=true
OPENFHE_PROFILE_ID=ckks-balanced-degree7-v1
OPENFHE_MAX_CIPHERTEXT_BUNDLE_BYTES=40000000
# Generate a separate random token for the protected Prometheus scrape endpoint.
OBSERVABILITY_METRICS_TOKEN=replace-with-at-least-32-random-characters
# Container alternative: OBSERVABILITY_METRICS_TOKEN_FILE=/run/secrets/metrics_token

ADMIN_DATABASE_URL=postgresql+psycopg://credit_risk_app:URL_ENCODED_PASSWORD@127.0.0.1:5432/privacy_credit_risk
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_JWT_SECRET=replace-with-at-least-32-random-characters
# Container alternative: ADMIN_JWT_SECRET_FILE=/run/secrets/admin_jwt_secret
ADMIN_ACCESS_TOKEN_MINUTES=15
ADMIN_REFRESH_TOKEN_DAYS=7
ADMIN_MAX_FAILED_LOGINS=5
ADMIN_LOCKOUT_MINUTES=15

# Used only by: python -m backend.scripts.seed_admin
ADMIN_SEED_EMAIL=admin@example.invalid
ADMIN_SEED_NAME=Local Super Admin
ADMIN_SEED_PASSWORD=replace-with-a-strong-unique-password

# Optional clearly labeled development seed; provide unique strong values.
DEMO_SUPER_ADMIN_PASSWORD=replace-with-strong-demo-password
DEMO_ANALYST_PASSWORD=replace-with-strong-demo-password
DEMO_AUDITOR_PASSWORD=replace-with-strong-demo-password
DEMO_SUPPORT_PASSWORD=replace-with-strong-demo-password
